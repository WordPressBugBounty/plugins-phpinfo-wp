{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "phpinfo() WP — Site Health, PHP Compatibility & Server Audit",
    "description": "Modern WordPress site health, PHP compatibility scanner, troubleshooting mode, and config audit. A maintained, in-admin alternative to Health Check.",
    "author": "Exeebit",
    "categories": [
      "site-health",
      "developer",
      "performance"
    ]
  },
  "landingPage": "/wp-admin/admin.php?page=piwp",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false
      }
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "phpinfo-wp"
      },
      "options": {
        "activate": true
      }
    }
  ]
}